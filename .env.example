# Copy to .env and adjust.  Every value is optional - the defaults below are what the
# app runs with out of the box (no API key required at all).

# --- Django -----------------------------------------------------------------
DJANGO_SECRET_KEY=django-insecure-change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=*
DJANGO_LOG_LEVEL=INFO

# --- Vehicle ----------------------------------------------------------------
SPOTTER_MPG=10
SPOTTER_MAX_RANGE_MILES=500
# 1.0 == depart with a full tank (already-on-board fuel is a sunk cost)
SPOTTER_INITIAL_FUEL_FRACTION=1.0
# How far off the route a truck stop may sit and still count as "on the route".
# Stop positions are city centroids, so be generous here.
SPOTTER_STATION_OFFSET_MILES=25

# --- Providers (all free; OSRM + Nominatim need no key) ---------------------
# ROUTING_PROVIDER:   osrm | ors
# GEOCODING_PROVIDER: nominatim | ors
SPOTTER_ROUTING_PROVIDER=osrm
SPOTTER_GEOCODING_PROVIDER=nominatim
ORS_API_KEY=
SPOTTER_HTTP_TIMEOUT_SECONDS=20

# --- Caching + geometry -----------------------------------------------------
# Cached in the DB, so a repeated origin/destination pair costs 0 external calls.
SPOTTER_CACHE_ENABLED=True
# Miles between consecutive polyline points (matching + response)
SPOTTER_GEOMETRY_SPACING_MILES=1.0
SPOTTER_OUTPUT_GEOMETRY_SPACING_MILES=2.0
# Ceiling on the response polyline, so a coast-to-coast route stays a small payload.
SPOTTER_MAX_OUTPUT_GEOMETRY_POINTS=600

# --- Offline data -----------------------------------------------------------
# Bundled US place gazetteer: lets "City, ST" resolve without a geocoding call.
SPOTTER_US_PLACES_PATH=data/us_places.json
# Truck-stop coordinates, built once by scripts/build_place_coords.py.
SPOTTER_PLACE_COORDS_PATH=data/place_coords.json

# --- Web client -------------------------------------------------------------
# Origins allowed to call this API from a browser (the web app's own origin).
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Practical planning knobs ----------------------------------------------
# Truck stops cluster; only the cheapest one in each stretch of this length is used as
# a possible purchase point. Larger -> fewer stops, marginally higher bill.
SPOTTER_MIN_STATION_SPACING_MILES=25
# Only divert to a station that beats the current price by at least this much per gallon.
# 0 keeps the solver at the true cost optimum; thinning below is what removes micro-stops.
SPOTTER_MIN_PRICE_ADVANTAGE_PER_GALLON=0.0
